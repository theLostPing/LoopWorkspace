+    // MARK: - Hands-free advisory pod alert acknowledgement (Brian, 2026-10-29)
+    //
+    // Clears an outstanding Omnipod ADVISORY alert by voice (Warden -> Nightscout ->
+    // APNs) without unlocking the phone -- from bed, or while driving.
+    //
+    // This does NOT silence, suppress, delay or reconfigure any alert. Every alert still
+    // fires exactly as it does today. This runs AFTER one has fired and does what tapping
+    // the on-screen button does: the pump manager clears the pod's alert slot (which stops
+    // the pod beeping and, if the pod's confirmation beeps are on, beeps back), the iOS
+    // notification is cleared, the in-app modal is dismissed, and the acknowledgement is
+    // recorded.
+    //
+    // SAFETY -- the allowlist below is the entire safety property:
+    //   * Only these four ADVISORY alerts can ever be cleared remotely.
+    //   * Every other Omnipod alert is excluded by omission: suspendInProgress,
+    //     suspendEnded, finishSetupReminder, unexpectedAlert, timeOffsetChangeDetected.
+    //   * Pod FAULTS -- occlusion, pod fault, the real 80-hour auto-off -- are
+    //     PodCommsError.podFault and never become a PumpManagerAlert at all, so they are
+    //     unreachable from this path under any input.
+    // Changing this list is a therapy-safety decision, not a refactor.
+    private static let remoteAcknowledgeablePodAlertIdentifiers: [String] = [
+        "userPodExpiration",    // slot3 -- pod expiration reminder
+        "podExpiring",          // slot7 -- pod expired
+        "podExpireImminent",    // slot2 -- shutdown imminent (advisory)
+        "lowReservoir"          // slot4 -- low reservoir
+    ]
+
+    // Queried in order. "Omni" is loopandlearn/OmnipodKit, which is what this workspace
+    // builds; the other two are the upstream split plugins. Shipping ONE hardcoded guess
+    // is how this feature shipped broken on 10/29.
+    private static let omnipodManagerIdentifiers = [
+        "Omni",          // loopandlearn/OmnipodKit -- this workspace
+        "Omnipod-Dash",  // LoopKit/OmniBLE
+        "Omnipod"        // LoopKit/OmniKit
+    ]
+
+    private static let repeatingAlertSuffix = "-repeating"
+
+    /// Ask the device to clear one alert, retrying briefly: the usual failure is simply
+    /// that the pod was not reachable at that instant.
+    private func acknowledgePodAlert(_ identifier: Alert.Identifier, attempts: Int = 3) async throws {
+        var lastError: Error?
+        for attempt in 1...attempts {
+            do {
+                try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+                    alertManager.acknowledgeAlertAwaitingDevice(identifier: identifier) { error in
+                        if let error = error {
+                            continuation.resume(throwing: error)
+                        } else {
+                            continuation.resume()
+                        }
+                    }
+                }
+                return
+            } catch {
+                lastError = error
+                log.default("Pod alert ack attempt %d/%d failed for %{public}@", attempt, attempts, identifier.alertIdentifier)
+                if attempt < attempts {
+                    try? await Task.sleep(nanoseconds: 3_000_000_000)
+                }
+            }
+        }
+        throw lastError ?? PodAlertAcknowledgementError.noAcknowledgeableAlerts
+    }
+
+    func acknowledgeRemotePodAlerts() async throws {
+
+        // What Loop still believes is outstanding.
+        var persistedAlerts: [PersistedAlert] = []
+        for managerIdentifier in Self.omnipodManagerIdentifiers {
+            let found: [PersistedAlert] = try await withCheckedThrowingContinuation { continuation in
+                alertManager.lookupAllUnacknowledgedUnretracted(managerIdentifier: managerIdentifier) { result in
+                    continuation.resume(with: result)
+                }
+            }
+            persistedAlerts.append(contentsOf: found)
+        }
+
+        // An alert with a repeatInterval is issued under BOTH "<id>" and "<id>-repeating";
+        // clearing only the base would leave the repeat scheduled and still buzzing.
+        let targets = persistedAlerts.filter { persisted in
+            let identifier = persisted.alert.identifier.alertIdentifier
+            let base = identifier.hasSuffix(Self.repeatingAlertSuffix)
+                ? String(identifier.dropLast(Self.repeatingAlertSuffix.count))
+                : identifier
+            return Self.remoteAcknowledgeablePodAlertIdentifiers.contains(base)
+        }
+
+        var lastError: Error?
+
+        if !targets.isEmpty {
+            var cleared = 0
+            for target in targets {
+                do {
+                    try await acknowledgePodAlert(target.alert.identifier)
+                    cleared += 1
+                } catch {
+                    lastError = error
+                }
+            }
+            if cleared > 0 {
+                log.default("Remote pod alert acknowledgement: cleared %d", cleared)
+                return
+            }
+            throw PodAlertAcknowledgementError.podUnreachable(lastError)
+        }
+
+        // REMOTE-ACK-BLIND-FALLBACK (Brian, 2026-11-04)
+        //
+        // Loop's store shows nothing outstanding, but the pod may still be beeping: any
+        // earlier ack that failed at the pod was recorded as acknowledged anyway (see
+        // AlertManager.acknowledgeAlert), which hides it from the lookup forever.
+        //
+        // So ask the pod directly to clear each ADVISORY alert. This is safe and does not
+        // widen the allowlist by one alert: OmniPumpManager.acknowledgeAlert guards on
+        // `hasActivePod && !state.activeAlerts.isEmpty` and then only acts on an
+        // identifier that is genuinely in activeAlerts -- anything else is a successful
+        // no-op. So this clears exactly what is really live on the pod, and nothing else.
+        log.default("Remote pod alert acknowledgement: store shows nothing; asking the pod directly")
+        var attempted = false
+        for managerIdentifier in Self.omnipodManagerIdentifiers {
+            for alertIdentifier in Self.remoteAcknowledgeablePodAlertIdentifiers {
+                let identifier = Alert.Identifier(managerIdentifier: managerIdentifier,
+                                                  alertIdentifier: alertIdentifier)
+                do {
+                    try await acknowledgePodAlert(identifier, attempts: 1)
+                    attempted = true
+                } catch {
+                    lastError = error
+                }
+            }
+        }
+
+        if let lastError = lastError {
+            throw PodAlertAcknowledgementError.podUnreachable(lastError)
+        }
+        guard attempted else {
+            throw PodAlertAcknowledgementError.noAcknowledgeableAlerts
+        }
+    }
+
+    enum PodAlertAcknowledgementError: LocalizedError {
+
+        case noAcknowledgeableAlerts
+        case podUnreachable(Error?)
+
+        var errorDescription: String? {
+            switch self {
+            case .noAcknowledgeableAlerts:
+                return NSLocalizedString("No pod alerts to clear", comment: "Pod alert acknowledgement error: nothing clearable is outstanding.")
+            case .podUnreachable(let underlying):
+                let detail = underlying.map { ": \($0.localizedDescription)" } ?? ""
+                return String(format: NSLocalizedString("Could not reach the pod to clear the alert%1$@", comment: "Pod alert acknowledgement error: the pod did not respond (1: underlying pod error)"), detail)
+            }
+        }
+    }
