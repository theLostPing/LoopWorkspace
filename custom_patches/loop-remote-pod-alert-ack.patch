+    /// REMOTE-ACK-AWAIT-DEVICE (Brian, 2026-11-04)
+    ///
+    /// Acknowledge an alert the way a REMOTE command has to: wait for the device to
+    /// confirm, and only record the acknowledgement if it actually succeeded.
+    ///
+    /// Why this exists. `acknowledgeAlert(identifier:)` above calls
+    /// `alertStore.recordAcknowledgement(of:)` unconditionally -- it is NOT inside the
+    /// responder's completion handler. So when the pod cannot be reached, Loop shows
+    /// "Unable To Clear Alert", the pod's alert slot is never cleared and it keeps
+    /// beeping, and yet the alert is marked acknowledged in the store. From then on it is
+    /// invisible to lookupAllUnacknowledgedUnretracted, so every later remote attempt
+    /// answers "No pod alerts to clear" while the pod is still screaming. One failed
+    /// attempt poisoned that alert permanently. That is the bug this method fixes.
+    ///
+    /// The tap path is deliberately left exactly as upstream wrote it.
+    func acknowledgeAlertAwaitingDevice(identifier: Alert.Identifier, completion: @escaping (Error?) -> Void) {
+        guard let responder = responders[identifier.managerIdentifier]?.value else {
+            // No such device loaded; nothing to clear on it.
+            completion(nil)
+            return
+        }
+        responder.acknowledgeAlert(alertIdentifier: identifier.alertIdentifier) { [weak self] error in
+            guard let self = self else {
+                completion(error)
+                return
+            }
+            if let error = error {
+                self.log.error("Remote acknowledgement of %{public}@ failed: %{public}@",
+                               identifier.alertIdentifier, String(describing: error))
+                // Deliberately NOT recorded: leaving it unacknowledged is what lets the
+                // next attempt find it again.
+                completion(error)
+                return
+            }
+            self.userNotificationAlertScheduler.acknowledgeAlert(identifier: identifier)
+            self.alertStore.recordAcknowledgement(of: identifier)
+            DispatchQueue.main.async {
+                self.modalAlertScheduler.removePresentedAlert(identifier: identifier)
+            }
+            completion(nil)
+        }
