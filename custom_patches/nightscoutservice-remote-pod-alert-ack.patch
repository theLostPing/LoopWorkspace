+/// Remote notification asking the app to clear outstanding ADVISORY pod alerts.
+///
+/// Wire shape mirrors OverrideCancelRemoteNotification: keyed by the presence of
+/// "acknowledge-pod-alerts", no parameters, no OTP. No OTP matches cancel-override,
+/// the closest existing precedent, which affects therapy -- this cannot: it
+/// acknowledges reminders that have already sounded, and nothing else.
+public struct PodAlertAcknowledgeRemoteNotification: RemoteNotification, Codable {
+
+    public let remoteAddress: String
+    public let expiration: Date?
+    public let sentAt: Date?
+    public let acknowledgePodAlerts: String
+    public let enteredBy: String?
+    public let otp: String?
+    public let encryptedReturnNotification: String?
+
+    enum CodingKeys: String, CodingKey {
+        case remoteAddress = "remote-address"
+        case expiration = "expiration"
+        case sentAt = "sent-at"
+        case acknowledgePodAlerts = "acknowledge-pod-alerts"
+        case enteredBy = "entered-by"
+        case otp = "otp"
+        case encryptedReturnNotification = "encrypted_return_notification"
+    }
+
+    func toRemoteAction() -> Action {
+        let action = PodAlertAcknowledgeAction(remoteAddress: remoteAddress)
+        return .acknowledgePodAlerts(action)
+    }
+
+    func otpValidationRequired() -> Bool {
+        return false
+    }
+
+    public static func includedInNotification(_ notification: [String: Any]) -> Bool {
+        return notification["acknowledge-pod-alerts"] != nil
+    }
+}
