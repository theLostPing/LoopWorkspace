+/// Payload for a remote request to acknowledge outstanding ADVISORY pod alerts.
+///
+/// Carries no parameters by design: the HOST owns the list of alerts that may be
+/// cleared this way, so a remote caller cannot name an alert and cannot widen the
+/// set. Nothing here can suppress an alert -- alerts still fire normally; this only
+/// acknowledges ones that have already fired.
+public struct PodAlertAcknowledgeAction: Codable {
+
+    let remoteAddress: String
+
+    public init(remoteAddress: String) {
+        self.remoteAddress = remoteAddress
+    }
+}
